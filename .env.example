# ─────────────────────────────────────────────────────────────
#  CO2_back — plantilla de entorno
#  Copiar a `.env` y completar. `.env` NO se versiona.
# ─────────────────────────────────────────────────────────────

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-esta-clave-antes-de-cualquier-despliegue
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,ws,nginx
# Origenes del front (RNF003: siempre https en despliegue real)
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:8443

# --- MySQL (RNF008) ---
MYSQL_DATABASE=co2
MYSQL_USER=co2
MYSQL_PASSWORD=cambiar-password-app
MYSQL_ROOT_PASSWORD=cambiar-password-root
MYSQL_HOST=mysql
MYSQL_PORT=3306

# --- Redis (ADR-0004) ---
# db0 pub/sub | db1 channel layer | db2 heartbeat | db3 cache
REDIS_URL=redis://redis:6379
REDIS_DB_PUBSUB=0
REDIS_DB_CHANNELS=1
REDIS_DB_HEARTBEAT=2
REDIS_DB_CACHE=3

# --- Controlador (ADR-0002) ---
# simulado | gpio   → 'gpio' solo tiene sentido sobre la Pi 5 real
CONTROLLER_HAL=simulado
# Frecuencia del lazo de control, en Hz
CONTROLLER_LOOP_HZ=100
# Frecuencia de publicacion de telemetria, en Hz (RF009 exige >= 1)
CONTROLLER_TELEMETRY_HZ=1
# TTL del heartbeat en segundos: si vence, el front muestra SIN CONEXION
CONTROLLER_HEARTBEAT_TTL=3

# --- Puertos publicados en el host ---
HOST_HTTP_PORT=8080
HOST_HTTPS_PORT=8443

# --- Arquitectura de destino (ADR-0005) ---
# linux/arm64 = simulacion de la Pi 5 (por defecto)
# linux/amd64 = desarrollo nativo rapido en x86
TARGET_PLATFORM=linux/arm64

# Repo del front (CO2_front). El compose lo construye y nginx lo sirve en /.
FRONT_DIR=../CO2_front

# Factor de aceleracion del laboratorio simulado (HAL simulado). 1 = tiempo real.
CONTROLLER_SIM_VELOCIDAD=1
